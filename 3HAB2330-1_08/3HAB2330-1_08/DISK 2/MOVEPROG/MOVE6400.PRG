      testload;
    CASE 4:
      irbtype:="IRB6400C";
      currload:=load_150;
      system:=150;
      testload;
    CASE 5:
      main;
    ENDTEST
  ENDPROC

  PROC testload()
    TPErase;
    TPReadFK answer,"Testload?","Yes","No","","","";
    TEST answer
    CASE 1:
    CASE 2:
      currload:=tool0;
