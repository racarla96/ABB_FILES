  PROC vibrate()
    TPErase;
    TPWrite "Vibration test";
    TPReadNum answer,"Select robot axis 1 to 6...";
    TEST answer
    CASE 1:
      TPWrite "Test vibrations on axis 1";
      MoveJ ax1_p1,v400,fine,currload;
      MoveJ ax1_p2,v80,fine,currload;
      MoveJ ax1_p1,v100,fine,currload;
      MoveJ ax1_p2,v150,fine,currload;
    CASE 2:
      TPWrite "Test vibrations on axis 2";
      MoveJ ax2_p1,v400,fine,currload;
      MoveJ ax2_p2,v80,fine,currload;
      MoveJ ax2_p1,v80,fine,currload;
      MoveJ ax2_p2,v100,fine,currload;
      MoveJ ax2_p1,v150,fine,currload;
    CASE 3:
      TPWrite "Test vibrations on axis 3";
      MoveJ ax3_p1,v400,fine,currload;
      MoveJ ax3_p2,v80,fine,currload;
      MoveJ ax3_p1,v100,fine,currload;
      MoveJ ax3_p2,v150,fine,currload;
    CASE 4:
      TPWrite "Test vibrations on axis 4";
      MoveJ ax4_p1,v400,fine,currload;
      MoveJ ax4_p2,v80h,fine,currload;
      MoveJ ax4_p1,v100h,fine,currload;
      MoveJ ax4_p2,v120h,fine,currload;
    CASE 5:
      TPWrite "Test vibrations on axis 5";
      MoveJ ax5_p1,v400,fine,currload;
      MoveJ ax5_p2,v80h,fine,currload;
      MoveJ ax5_p1,v100h,fine,currload;
      MoveJ ax5_p2,v120h,fine,currload;
    CASE 6:
      TPWrite "Test vibrations on axis 6";
      MoveJ ax6_p1,v400,fine,currload;
      MoveJ ax6_p2,v80h,fine,currload;
      MoveJ ax6_p1,v100h,fine,currload;
      MoveJ ax6_p2,v120h,fine,currload;
    DEFAULT:
      RETURN;
    ENDTEST
  ENDPROC

  PROC lash()
    TPErase;
    TPReadFK answer,"Test lash on axis 1, 5 or 6...","Ax1","Ax5","Ax6","","Exit";
    TEST answer
    CASE 1:
    TPReadFK answer,"Test lash on 0 deg. axis 1..","TEST","","","","";
      MoveJ ax1_lash1,v300,fine,tool0;
    CASE 2:
    TPReadFK answer,"Test lash on -90 deg. axis 5...","TEST","","","","";
      MoveJ ax5_lash1,v300,fine,tool0;
      TPReadFK answer,"Test lash on 0 deg. axis 5...","TEST","","","","";
      MoveJ ax5_lash2,v300,fine,tool0;
      TPReadFK answer,"Test lash on +90 deg. axis 5...","TEST","","","","";
      MoveJ ax5_lash3,v300,fine,tool0;
    CASE 3:
    TPReadFK answer,"Test lash on -180 deg. axis 6...","TEST","","","","";
      MoveJ ax6_lash1,v300,fine,tool0;
      TPReadFK answer,"Test lash on 0 deg. axis 6...","TEST","","","","";
      MoveJ ax6_lash2,v300,fine,tool0;
      TPReadFK answer,"Test lash on +180 deg. axis 6...","TEST","","","","";
      MoveJ ax6_lash3,v300,fine,tool0;
    CASE 5:
      RETURN;
    ENDTEST
  ENDPROC
