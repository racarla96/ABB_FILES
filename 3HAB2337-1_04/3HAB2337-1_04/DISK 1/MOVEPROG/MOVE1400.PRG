  PROC main()
    reg1:=0;
    TPWrite "MOVE PROGRAM";
    TPReadFK answer,"Select type of IRB...","1400","1400H","","","EXIT";
    TEST answer
    CASE 1:
      irbtype:="IRB1400";
      move_prog:=1400;
      acclim_count:=6;
      move_count:=760;
    CASE 2:
      irbtype:="IRB1400H";
      move_prog:=1401;
      acclim_count:=10;
      move_count:=1200;
    CASE 5:
      TPWrite "Exit program";
      EXIT;
    ENDTEST
    TPErase;
    TPWrite "Move program for ";
    TPWrite irbtype;
    TPReadFK answer,"TEST LOAD?","Yes","No","","","";
    TEST answer
    CASE 1:
      currload:=loadtool;
    CASE 2:
      currload:=tool0;
    ENDTEST
    TPReadFK answer,"Acceleration limit 50% first 10 minutes?","Yes","No","","","Exit";
    TEST answer
    CASE 1:
     FOR i FROM 1 TO acclim_count DO
      TPWrite irbtype;
      TPWrite "Main program, Acceleration limit 50%";
      TPWrite "Cycle "\Num:=i;
      IF move_prog=1400 move_1400;
      IF move_prog=1401 move_1400H;
     ENDFOR
     FOR i FROM 1 TO move_count DO
      TPWrite irbtype;
      TPWrite "Main program";
      TPWrite "Cycle "\Num:=i;
      IF move_prog=1400 move_1400;
      IF move_prog=1401 move_1400H;
     ENDFOR
    CASE 2:
     FOR i FROM 1 TO move_count DO
      TPWrite irbtype;
      TPWrite "Main program";
      TPWrite "Cycle "\Num:=i;
      IF move_prog=1400 move_1400;
      IF move_prog=1401 move_1400H;
     ENDFOR
    CASE 5:
      TPWrite "Exit program";
      EXIT;
    ENDTEST
    TPErase;
    TPWrite "************ PROGRAM END ************";
    TPWrite "************ PROGRAM END ************";
    TPWrite "************ PROGRAM END ************";
  ENDPROC

