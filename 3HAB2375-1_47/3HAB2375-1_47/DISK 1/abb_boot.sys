/**************************/
/* Konfiguration - s4 0.8 */
/**************************/

/* Bootline */
BOOT:  h=138.221.45.100 n=srow100 b=138.221.1%1.2 g=138.221.1%1.1 j=138.221.1%1.1:ffffff00 \
 i=138.221.1%1.3:ffffff00 k=138.221.1%1.2:ffffff00 e=138.221.45.%1:ffffff00 \
 s=/users/srocxx/boot/rbos_mc.bat 

/* RAMDISK storlek */
RAMDISK: 500000

/* Permanent Pool */
PERMANENT_POOL: 1500000

/* VMEBus request level */
/* huvuddator - 3       */
/* bandator   - 2       */
BRL: 3

/* VME Slave address    */
/* huvuddator - 0x0     */
/* bandator   - 0x40000 */
VMESLAVE: 0x0

/* VxWorks tick rate */
TICK_RATE: 100

/* Slut... */
