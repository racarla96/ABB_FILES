  PERS tooldata loadtool2:=[TRUE,[[0,0,0],[1,0,0,0]],[10,[100,0,100],[1,0,0,0],0,0,0]];
  PERS tooldata loadtool3:=[TRUE,[[0,0,0],[1,0,0,0]],[16,[100,0,100],[1,0,0,0],0,0,0]];
  PERS tooldata currload:=[TRUE,[[0,0,0],[1,0,0,0]],[5,[67,0,76],[1,0,0,0],0,0,0]];

  PROC haupt()
    main;
  ENDPROC

  PROC main()
    reg1:=0;
    TPWrite "IRB2400 Moveprogram";
    TPReadFK answer,"Select type of IRB2400/...","L","10","16","","Exit";
    TEST answer
    CASE 1:
      irbtype:="IRB 2400/L";
      testload;
      move2400_L;
    CASE 2:
      irbtype:="IRB 2400/10";
      testload;
      move2400_10;
    CASE 3:
      irbtype:="IRB 2400/16";
      testload;
      move2400_16;
    CASE 5:
      EXIT;
    ENDTEST
    TPErase;
    time:=ClkRead(clock1);
    time:=time/3600;
    TPWrite "*******PROGRAM END*******";
    TPWrite "*******PROGRAM END*******";
    TPWrite "*******PROGRAM END*******";
    TPWrite "Test time (h): "\Num:=time;
  ENDPROC

  PROC testload()
    TPErase;
    TPWrite "Move program for ";
    TPWrite irbtype;
    TPReadFK answer,"TEST LOAD?","5kg","10kg","16kg","","No";
    TEST answer
    CASE 1:
      currload:=loadtool1;
    CASE 2:
      currload:=loadtool2;
    CASE 3:
      currload:=loadtool3;
    CASE 5:
      currload:=tool0;
    ENDTEST
  ENDPROC

